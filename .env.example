# GoRentHive configuration
# Copy to server/.env locally, or set these as Environment variables in your
# host (e.g. Render). NEVER put a service-role key in browser code or commit it.

# Server port (default 4000)
PORT=4000

# Payment gateway: "sandbox" (no real money), "gcash", or "paymongo"
# (paymongo needs PAYMONGO_SECRET_KEY + PAYMONGO_PUBLIC_KEY + PAYMONGO_WEBHOOK_SECRET)
GATEWAY=sandbox

# Supabase project (GoRentHive)
SUPABASE_URL=https://tdztzjetxnjqwvgolpvz.supabase.co

# Public anon key (safe to expose in the browser / public code)
SUPABASE_ANON_KEY=your-anon-key

# SECRET server-only key (used for money moves, admin, private routes).
# NEVER commit this. In Render, set it as an env var, not in the repo.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Optional: real GCash gateway (only if GATEWAY=gcash) ----
GCASH_CLIENT_ID=
GCASH_SECRET=
GCASH_SANDBOX=https://sandbox-paygw.dfpay.co/dfpay/v1
GCASH_PROD=https://paygw.dfpay.co/dfpay/v1

# ---- Optional: PayMongo (only if GATEWAY=paymongo) ----
# Create keys at https://dashboard.paymongo.com. Register the webhook URL
# https://<your-host>/api/paymongo/webhook and set the webhook secret here.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Public base URL used to build PayMongo return URLs (e.g. https://gorenthive.online)
PUBLIC_BASE_URL=https://gorenthive.online
