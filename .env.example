# GoRentHive production configuration
# Copy to server/.env locally, or set as environment variables in Render.
# NEVER commit real secret/service-role keys.

PORT=4000
NODE_ENV=development
CANON_HOST=gorenthive.online
PUBLIC_BASE_URL=https://gorenthive.online

# Payment gateway
# Development may use sandbox. Production MUST use paymongo and real keys.
GATEWAY=sandbox
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production verification delivery
# These are HTTPS server-to-server webhook endpoints you control or connect to
# an approved SMS/email provider. They receive JSON payloads from GoRentHive.
# Production verification fails closed when these are not configured.
SMS_SENDER_WEBHOOK_URL=
SMS_SENDER_WEBHOOK_SECRET=
EMAIL_SENDER_WEBHOOK_URL=
EMAIL_SENDER_WEBHOOK_SECRET=

# Legacy direct GCash adapter (not used when GATEWAY=paymongo)
GCASH_CLIENT_ID=
GCASH_SECRET=
GCASH_SANDBOX=https://sandbox-paygw.dfpay.co/dfpay/v1
GCASH_PROD=https://paygw.dfpay.co/dfpay/v1

# Launch checklist:
# 1) Run all pending supabase/migrations/*.sql in Supabase SQL Editor.
# 2) Set NODE_ENV=production and GATEWAY=paymongo in Render.
# 3) Configure PayMongo live/test keys appropriate to the deployment stage.
# 4) Register https://gorenthive.online/api/paymongo/webhook and set its secret.
# 5) Configure SMS/email sender webhooks before requiring user verification.
# 6) Never use SUPABASE_SERVICE_ROLE_KEY in browser/public files.
