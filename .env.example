# GoRentHive configuration template
# Copy to a local .env file or configure through Render.
# Never commit real secret, service-role, payment, email, or SMS API keys.

PORT=4000
NODE_ENV=development
CANON_HOST=gorenthive.online
PUBLIC_BASE_URL=https://gorenthive.online

# Payment provider
# Production Render configuration currently expects PayMongo.
GATEWAY=paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Verification delivery
# Email: https://resend.com — verify your sending domain before production use.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GoRentHive <verify@mail.gorenthive.online>

# SMS/OTP: https://semaphore.co — use an approved sender name for production.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=GORENTHIVE

# Production checklist
# 1. Apply pending supabase/migrations/*.sql.
# 2. Set NODE_ENV=production in Render.
# 3. Configure PayMongo keys for the correct environment.
# 4. Register https://gorenthive.online/api/paymongo/webhook.
# 5. Verify the Resend sending domain and configure RESEND_API_KEY + RESEND_FROM_EMAIL.
# 6. Fund Semaphore, approve the sender name, and configure SEMAPHORE_API_KEY + SEMAPHORE_SENDER_NAME.
# 7. Never expose SUPABASE_SERVICE_ROLE_KEY, PAYMONGO_SECRET_KEY, RESEND_API_KEY, or SEMAPHORE_API_KEY to browser code.
