# GoRentHive configuration template
# Copy to a local .env file or configure through Render.
# Never commit real secret, service-role, or webhook keys.

PORT=4000
NODE_ENV=development
CANON_HOST=gorenthive.online
PUBLIC_BASE_URL=https://gorenthive.online

# Payment provider
# Production Render configuration currently expects PayMongo.
GATEWAY=paymongo
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Verification delivery
# Production verification fails closed when required sender integrations are absent.
SMS_SENDER_WEBHOOK_URL=
SMS_SENDER_WEBHOOK_SECRET=
EMAIL_SENDER_WEBHOOK_URL=
EMAIL_SENDER_WEBHOOK_SECRET=

# Production checklist
# 1. Apply pending supabase/migrations/*.sql.
# 2. Set NODE_ENV=production in Render.
# 3. Configure PayMongo keys for the correct environment.
# 4. Register https://gorenthive.online/api/paymongo/webhook.
# 5. Configure SMS/email sender integrations before enforcing verification.
# 6. Never expose SUPABASE_SERVICE_ROLE_KEY or PAYMONGO_SECRET_KEY to browser code.
